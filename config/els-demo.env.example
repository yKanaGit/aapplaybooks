# ELS Demo Environment Configuration
# Copy this file to els-demo.env and edit values

# Satellite Configuration
SATELLITE_HOST="satellite"
SATELLITE_USER="ec2-user"

# Organization and Environment
ORGANIZATION="Default Organization"
LIFECYCLE_ENV="RHEL7_Dev"

# Content Views
BASE_CONTENT_VIEW="RHEL7"
ELS_CONTENT_VIEW="RHEL7-ELS"

# Node Configuration
NODE1_HOST="node1.example.com"
NODE2_HOST="node2.example.com"
NODE3_HOST="node3.example.com"
NODE_USER="ec2-user"

# Optional: SSH Configuration
# BASTION_HOST="bastion.example.com"
# BASTION_USER="ec2-user"
# BASTION_PORT="22"
