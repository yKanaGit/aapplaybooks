# Lightspeed on-premises Setup Configuration
# Copy this file to ../lightspeed.env and customize for your environment

# ===== Bastion (Jump Host) Configuration =====
# Required: SSH connection information for the bastion host
BASTION_USER="your-bastion-username"
BASTION_HOST="bastion.example.com"
BASTION_PORT="22"

# ===== Satellite Configuration =====
# SSH connection information for Satellite server (internal hostname/IP)
# These are accessed via the bastion host
SATELLITE_USER="ec2-user"
SATELLITE_HOST="satellite"

# ===== Managed Host (node1) Configuration =====
# SSH connection information for the managed RHEL host
# These are accessed via the bastion host
NODE1_USER="ec2-user"
NODE1_HOST="node1"
NODE1_HOSTNAME="node1.example.com"

# ===== Execution Options =====
# Set to "true" to perform a dry run (no changes will be made)
# DRY_RUN="false"

# ===== Notes =====
# 1. Bastion configuration is required - the script connects to Satellite
#    and node1 through the bastion host
#
# 2. The script uses SSH keys configured on the bastion host for connecting
#    to Satellite and node1. SSH Agent Forwarding is not used.
#
# 3. Passwordless sudo must be configured on both Satellite and node1
#
# 4. SSH host keys should be already accepted on the bastion host, or
#    StrictHostKeyChecking=accept-new will be used
#
# 5. Sensitive information (Red Hat Registry credentials, Satellite admin
#    credentials) will be prompted interactively during execution and
#    will not be saved to this file
#
# 6. After RHDP environment re-provisioning, update:
#    - BASTION_HOST (external FQDN or IP address)
#    - BASTION_USER (if changed)
#    - Other values can typically use the defaults
#
# 7. Do not commit this file with actual credentials to version control
#    The .gitignore file is configured to exclude lightspeed.env
